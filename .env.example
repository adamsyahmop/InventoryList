# Salin file ini menjadi `.env` lalu sesuaikan nilainya.

# --- Database ---------------------------------------------------------------
# SQLite (default, portable & tanpa server):
DATABASE_URL="file:./dev.db"
#
# PostgreSQL (tinggal ganti provider di prisma/schema.prisma menjadi
# `postgresql`, lalu jalankan ulang migrasi):
# DATABASE_URL="postgresql://user:password@localhost:5432/inventory?schema=public"

# --- Autentikasi ------------------------------------------------------------
# Password untuk masuk ke aplikasi.
APP_PASSWORD="admin"

# Kunci HMAC untuk menandatangani cookie sesi.
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-only-insecure-secret-change-me"
