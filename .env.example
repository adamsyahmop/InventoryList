# Salin file ini menjadi `.env` lalu sesuaikan nilainya.

# --- Database ---------------------------------------------------------------
# SQLite (default, portable & tanpa server):
DATABASE_URL="file:./dev.db"
#
# PostgreSQL (tinggal ganti provider di prisma/schema.prisma menjadi
# `postgresql`, lalu jalankan ulang migrasi):
# DATABASE_URL="postgresql://user:password@localhost:5432/inventory?schema=public"

# --- Autentikasi ------------------------------------------------------------
# Keduanya WAJIB diisi sebelum `next start` / produksi. Aplikasi sengaja
# berhenti (error) bila kosong, terlalu pendek, atau masih memakai nilai contoh
# yang tertulis di repo — nilai cadangan seperti "admin" hanya berlaku di
# `next dev`.
#
# Password untuk masuk ke aplikasi.
APP_PASSWORD=""

# Kunci HMAC untuk menandatangani cookie sesi. Minimal 32 karakter.
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Opsional ---------------------------------------------------------------
# Batas label per halaman cetak massal (`/items/labels`). Default 200.
# LABELS_MAX="200"

# Di Docker (lihat docker-compose.yml) DATABASE_URL diarahkan ke volume:
# DATABASE_URL="file:/data/app.db"
