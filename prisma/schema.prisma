// Prisma schema — Inventory List
// Docs: https://pris.ly/d/prisma-schema
//
// CATATAN MIGRASI (SQLite -> PostgreSQL):
// Ganti `provider` di bawah menjadi "postgresql" lalu buat migration baru.
// Seluruh model sengaja hanya memakai tipe yang portabel
// (String, Int, DateTime, Boolean, enum) tanpa tipe khusus SQLite/Postgres.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Siklus hidup barang
enum ItemStatus {
  AVAILABLE // tersedia di lokasi
  IN_USE // sedang dipakai
  BORROWED // sedang dipinjam
  MAINTENANCE // dalam perbaikan
  LOST // hilang
  DISPOSED // dibuang / dimusnahkan
  SOLD // dijual
}

/// Kondisi fisik barang
enum ItemCondition {
  NEW // baru
  GOOD // baik
  FAIR // cukup
  NEEDS_REPAIR // perlu perbaikan
  DAMAGED // rusak berat
}

/// Sumber perolehan / pendanaan barang.
/// Menjawab "siapa yang membeli": kantor pusat atau cabang itu sendiri.
/// Sengaja dipisah dari `Category` (barang APA) dan `Location` (barang DI MANA).
enum AcquisitionSource {
  HEAD_OFFICE // dibeli / dibiayai kantor pusat
  BRANCH // dibeli / dibiayai cabang
}

/// Cabang / unit kerja (master data)
model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations    Location[]
  /// Barang yang dibeli / dibiayai cabang ini.
  sourcedItems Item[]     @relation("ItemSourceBranch")
  /// Barang yang menjadi aset milik cabang ini.
  ownedItems   Item[]     @relation("ItemOwnerBranch")
  /// Sesi opname yang lingkupnya cabang ini.
  opnames      StockOpname[]

  @@index([name])
  @@map("branches")
}

/// Unit pengelola / departemen (master data)
///
/// Menjawab "siapa yang memakai & mengurus barang ini sehari-hari" (mis. IT,
/// GA). Sengaja dipisah dari `Category` (barang APA), `assetType` (wujud
/// fisik/akhiran kode), `Location` (barang DI MANA), dan `Branch`
/// (kepemilikan). Satu unit bisa mengelola banyak jenis barang, dan satu
/// barang bisa berpindah unit TANPA mengubah kode yang sudah ditempel di fisik
/// barang.
model Department {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  @@index([name])
  @@map("departments")
}

/// Kategori barang (master data)
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String?  @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items Item[]

  @@map("categories")
}

/// Merek barang (master data)
model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  @@map("brands")
}

/// Lokasi aktual barang (master data)
model Location {
  id        String   @id @default(cuid())
  name      String
  building  String?
  floor     String?
  room      String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Cabang tempat lokasi ini berada. Satu cabang boleh punya banyak ruangan,
  /// jadi cabang tidak dijadikan bagian dari `name` saja.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  items     Item[]
  movesFrom ItemMovement[] @relation("MovementFromLocation")
  movesTo   ItemMovement[] @relation("MovementToLocation")
  /// Sesi opname yang lingkupnya lokasi ini.
  opnames StockOpname[]

  @@index([name])
  @@index([branchId])
  @@map("locations")
}

/// Supplier / vendor (master data)
model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  contact   String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  @@map("suppliers")
}

/// Data utama barang
model Item {
  id   String @id @default(cuid())
  /// Kode unik yang dibaca manusia, contoh: INV-2026-0001.
  /// Sejak fitur label QR, kode baru memakai akhiran jenis aset supaya lebih
  /// informatif namun tetap pendek: INV-2026-0011-LPT. Kode lama tidak diubah.
  code String @unique
  /// Jenis aset (suffix kode), mis. "PC", "LPT", "PRN". Sengaja String dan bukan
  /// enum supaya daftar jenis bisa ditambah tanpa migrasi; nilai yang sah dijaga
  /// `ITEM_TYPE_VALUES` di `src/lib/constants.ts` + `assetType` di `validations.ts`.
  assetType String?

  name          String
  model         String?
  quantity      Int           @default(1)
  unit          String        @default("pcs")
  purchaseDate  DateTime?
  /// Harga disimpan sebagai integer rupiah (tanpa desimal) agar portabel
  price         Int           @default(0)
  invoiceNo     String?
  warrantyUntil DateTime?
  condition     ItemCondition @default(GOOD)
  status        ItemStatus    @default(AVAILABLE)
  assignedTo    String?
  serialNumber  String?
  photoUrl      String?
  notes         String?

  /// Kolom turunan (lowercase) untuk pencarian case-insensitive yang
  /// berperilaku sama di SQLite maupun PostgreSQL.
  searchKey String @default("")

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId    String?
  brand      Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  /// Unit pengelola (mis. IT / GA). Dimensi terpisah dari jenis aset & lokasi:
  /// barang bisa berpindah unit tanpa mengubah kode yang sudah dicetak.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  /// Siapa yang membeli/membiayai barang ini.
  acquisitionSource AcquisitionSource @default(HEAD_OFFICE)
  /// Cabang pembeli; hanya diisi bila `acquisitionSource` = BRANCH.
  sourceBranchId    String?
  sourceBranch      Branch?           @relation("ItemSourceBranch", fields: [sourceBranchId], references: [id], onDelete: SetNull)
  /// Pemilik aset. Barang bisa dibeli pusat tapi jadi aset cabang, atau sebaliknya.
  ownerBranchId     String?
  ownerBranch       Branch?           @relation("ItemOwnerBranch", fields: [ownerBranchId], references: [id], onDelete: SetNull)

  /// Metadata pelepasan aset. `price` tetap menyimpan harga PEROLEHAN (tidak
  /// pernah dinolkan) supaya nilai historis & audit tidak hilang; yang
  /// dikeluarkan dari "nilai aset aktif" adalah statusnya.
  disposedAt     DateTime?
  disposalReason String?
  soldAt         DateTime?
  /// Harga jual aktual; berbeda dari `price` yang merupakan harga beli.
  soldPrice      Int?

  movements ItemMovement[]
  /// Baris stock opname yang menyebut barang ini (snapshot tetap ada walau
  /// barangnya kemudian dihapus).
  opnameLines StockOpnameLine[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete: data tidak benar-benar dihapus dari database
  deletedAt DateTime?
  createdBy String?

  @@index([searchKey])
  @@index([status])
  @@index([categoryId])
  @@index([departmentId])
  @@index([locationId])
  @@index([sourceBranchId])
  @@index([ownerBranchId])
  @@index([deletedAt])
  @@map("items")
}

/// Riwayat perpindahan lokasi & perubahan status barang
model ItemMovement {
  id             String      @id @default(cuid())
  itemId         String
  fromLocationId String?
  toLocationId   String?
  fromStatus     ItemStatus?
  toStatus       ItemStatus?
  quantity       Int         @default(1)
  reason         String?
  notes          String?
  movedBy        String?
  movedAt        DateTime    @default(now())

  item         Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromLocation Location? @relation("MovementFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   Location? @relation("MovementToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([movedAt])
  @@map("item_movements")
}

/// Status sesi stock opname
enum OpnameStatus {
  OPEN // sedang dihitung
  CLOSED // sudah ditutup, selisih sudah diterapkan ke stok
}

/// Sesi stock opname: pengecekan fisik stok pada satu lingkup.
///
/// Lingkup disimpan sebagai snapshot teks (`scopeLabel`) PLUS id opsional, supaya
/// sesi lama tetap terbaca walau lokasi/cabangnya kemudian dihapus atau diganti
/// nama. Baris (StockOpnameLine) juga menyimpan kode/nama barang sebagai
/// snapshot dengan alasan yang sama.
model StockOpname {
  id String @id @default(cuid())
  /// Kode yang dibaca manusia: OPN-2026-0001
  code   String       @unique
  status OpnameStatus @default(OPEN)

  scopeLabel String
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  branchId   String?
  branch     Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  note      String?
  createdBy String?
  startedAt DateTime  @default(now())
  closedAt  DateTime?

  lines StockOpnameLine[]

  @@index([status])
  @@index([startedAt])
  @@map("stock_opnames")
}

/// Satu baris hitung dalam sesi opname: stok sistem vs hasil hitung fisik.
model StockOpnameLine {
  id       String       @id @default(cuid())
  opnameId String
  opname   StockOpname  @relation(fields: [opnameId], references: [id], onDelete: Cascade)

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  /// Snapshot identitas barang saat sesi dimulai.
  itemCode     String
  itemName     String
  locationName String?

  /// Stok sistem saat sesi dimulai (bukan saat ditutup).
  expectedQty Int
  /// Hasil hitung fisik; `null` = belum dihitung.
  countedQty  Int?
  note        String?
  countedAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([opnameId, itemCode])
  @@index([opnameId])
  @@map("stock_opname_lines")
}

/// Peran pengguna aplikasi.
///
/// ADMIN  — semua akses, termasuk mengelola akun & menghapus data master.
/// STAFF  — pekerjaan inventaris sehari-hari (barang, perpindahan, opname, impor).
/// VIEWER — hanya membaca: daftar, detail, riwayat, ekspor, cetak label.
enum UserRole {
  ADMIN
  STAFF
  VIEWER
}

/// Akun pengguna.
///
/// Riwayat pergerakan menyimpan `movedBy` sebagai TEKS (username), bukan relasi
/// ke tabel ini: kalau akun dihapus, jejak audit tidak boleh ikut hilang atau
/// berubah menjadi `null`.
model User {
  id           String    @id @default(cuid())
  /// Huruf kecil, dipakai untuk login (disimpan sudah dinormalisasi).
  username     String    @unique
  name         String
  /// `scrypt$<salt hex>$<hash hex>` — lihat src/lib/passwords.ts.
  passwordHash String
  role         UserRole  @default(STAFF)
  /// Akun nonaktif langsung kehilangan akses walau cookie-nya masih sah.
  active       Boolean   @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("users")
}
